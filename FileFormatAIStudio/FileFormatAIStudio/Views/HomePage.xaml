<Page
    x:Class="FileFormatAIStudio.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32,28,32,32" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="28">

                <!-- Hero Header Section -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="28,24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Studio Icon Badge -->
                        <Border Grid.Column="0"
                                Width="72"
                                Height="72"
                                CornerRadius="16"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8BD;"
                                      FontSize="34"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Title, Version & Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AppName, Mode=OneWay}"
                                           Style="{ThemeResource TitleTextBlockStyle}"
                                           FontSize="26"
                                           FontWeight="Bold" />

                                <Border Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.AppDescription, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       MaxWidth="750" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quick Actions Section -->
                <StackPanel Spacing="14">
                    <TextBlock Text="Quick Actions"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Action Card 1: New Chat -->
                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnStartNewChatClicked">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20,18"
                                    HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="8"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE710;"
                                                  FontSize="20"
                                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="Start New Chat"
                                                   FontWeight="SemiBold"
                                                   FontSize="15" />
                                        <TextBlock Text="Initiate a conversation with your configured AI models."
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE76C;"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Action Card 2: Settings -->
                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnOpenSettingsClicked">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20,18"
                                    HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="8"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE713;"
                                                  FontSize="20"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="Configure Settings &amp; Models"
                                                   FontWeight="SemiBold"
                                                   FontSize="15" />
                                        <TextBlock Text="Manage API keys, cloud providers, and local Ollama models."
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE76C;"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Features Overview Grid -->
                <StackPanel Spacing="14">
                    <TextBlock Text="Key Features"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Feature 1 -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE99A;"
                                          FontSize="22"
                                          HorizontalAlignment="Left"
                                          Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                <TextBlock Text="Multi-Model AI"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock Text="Seamlessly switch between OpenAI, Ollama, and custom OpenAI-compatible models."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Feature 2 -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE72E;"
                                          FontSize="22"
                                          HorizontalAlignment="Left"
                                          Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                <TextBlock Text="DPAPI Encryption"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock Text="API keys and credentials are encrypted on your local machine using Windows DPAPI."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Feature 3 -->
                        <Border Grid.Column="2"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE8D2;"
                                          FontSize="22"
                                          HorizontalAlignment="Left"
                                          Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                <TextBlock Text="Local History &amp; SQLite"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock Text="All chat sessions, messages, and configurations are stored in an embedded SQLite database."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
