<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileFormatAIStudio.Views.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:bench="using:FileFormatAIStudio.Services.Benchmarking"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="36,28,36,36" RowSpacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Extraction Benchmark &amp; Comparison"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="Benchmark and rank document text extraction completeness, speed, memory, and cleanliness across all supported parsing libraries."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="14" />
            </StackPanel>

            <!-- 2. Status InfoBar -->
            <InfoBar Grid.Row="1"
                     IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <!-- 3. Category Selection & Format Filter -->
            <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Category Cards Row -->
                <ListView Grid.Row="0"
                          ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                          SelectionMode="Single"
                          HorizontalAlignment="Stretch">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BenchmarkCategoryItem">
                            <Border BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Width="180">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind FormatsSummary}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Supported Formats Info -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Supported Category Formats:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="bench:DocumentFormatDescriptor">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{x:Bind Extension}" FontSize="11" FontWeight="Medium" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- 4. Document Upload & Drag-and-Drop Card -->
            <Border Grid.Row="3"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="10"
                    Padding="24">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drop Zone -->
                    <Border Grid.Row="0"
                            x:Name="DropZoneBorder"
                            AllowDrop="True"
                            DragOver="OnDragOver"
                            Drop="OnDrop"
                            BorderThickness="2"
                            BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            CornerRadius="8"
                            Padding="28,24"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE898;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Drag &amp; drop document files here to benchmark"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Compatible with .docx, .doc, .xlsx, .xls, .pptx, .ppt, .pdf, .txt, .csv"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                            <Button Content="Browse Documents..."
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0"
                                    Click="OnBrowseFilesClicked" />
                        </StackPanel>
                    </Border>

                    <!-- Selected Files List -->
                    <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.HasSelectedFiles, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="SELECTED DOCUMENTS TO BENCHMARK"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="Clear All"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    FontSize="12"
                                    Margin="12,0,0,0"
                                    Click="OnClearFilesClicked" />
                        </StackPanel>

                        <ListView ItemsSource="{x:Bind ViewModel.SelectedFiles, Mode=OneWay}"
                                  SelectionMode="None"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  CornerRadius="6">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BenchmarkFileItemViewModel">
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontWeight="Medium" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedFileSize}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Button Grid.Column="3"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                Padding="6"
                                                Click="OnRemoveFileItemClicked">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Action Bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                Height="40"
                                Padding="20,0"
                                IsEnabled="{x:Bind ViewModel.CanRunBenchmark, Mode=OneWay}"
                                Command="{x:Bind ViewModel.RunBenchmarkCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Run Multi-Library Benchmark" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Real-Time Progress Card (Visible during execution) -->
            <Border Grid.Row="4"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="10"
                    Padding="24"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressStage, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>

                    <ProgressBar Grid.Row="1"
                                 Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                                 Maximum="100"
                                 Height="8"
                                 CornerRadius="4" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                        <Button Content="Cancel Benchmark"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Command="{x:Bind ViewModel.CancelBenchmarkCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. Historical Sessions Expander -->
            <Expander Grid.Row="5"
                      Header="Recent Benchmark Sessions"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="False">
                <ListView ItemsSource="{x:Bind ViewModel.RecentSessions, Mode=OneWay}"
                          SelectionMode="None"
                          Padding="0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:BenchmarkSessionEntity">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="Medium" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Category}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedDate}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Grid.Column="4"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Padding="6"
                                        Click="OnDeleteSessionClicked">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>

