<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileFormatAIStudio.Views.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:bench="using:FileFormatAIStudio.Services.Benchmarking"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="36,28,36,36" RowSpacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Extraction Benchmark &amp; Comparison"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="Benchmark and rank document text extraction completeness, speed, memory, and cleanliness across all supported parsing libraries."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="14" />
            </StackPanel>

            <!-- 2. Status InfoBar -->
            <InfoBar Grid.Row="1"
                     IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <!-- 3. Category Selection & Format Filter -->
            <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Fluent Segmented / Pill Strip -->
                <Border Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="4"
                        HorizontalAlignment="Left">
                    <ListView ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              Margin="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,8" />
                                <Setter Property="Margin" Value="2,0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="CornerRadius" Value="7" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BenchmarkCategoryItem">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind FormatsSummary}">
                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                              FontSize="15"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- Supported Formats Info -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Supported Formats:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="bench:DocumentFormatDescriptor">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{x:Bind Extension}" FontSize="11" FontWeight="Medium" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- 4. Document Upload & Drag-and-Drop Card -->
            <Border Grid.Row="3"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="10"
                    Padding="24">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drop Zone -->
                    <Border Grid.Row="0"
                            x:Name="DropZoneBorder"
                            AllowDrop="True"
                            DragOver="OnDragOver"
                            Drop="OnDrop"
                            BorderThickness="2"
                            BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            CornerRadius="8"
                            Padding="28,24"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE898;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Drag &amp; drop document files here to benchmark"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Compatible with .docx, .doc, .xlsx, .xls, .pptx, .ppt, .pdf, .txt, .csv"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                            <Button Content="Browse Documents..."
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0"
                                    Click="OnBrowseFilesClicked" />
                        </StackPanel>
                    </Border>

                    <!-- Selected Files List -->
                    <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.HasSelectedFiles, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="SELECTED DOCUMENTS TO BENCHMARK"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="Clear All"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    FontSize="12"
                                    Margin="12,0,0,0"
                                    Click="OnClearFilesClicked" />
                        </StackPanel>

                        <ListView ItemsSource="{x:Bind ViewModel.SelectedFiles, Mode=OneWay}"
                                  SelectionMode="None"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  CornerRadius="6">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BenchmarkFileItemViewModel">
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontWeight="Medium" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedFileSize}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Button Grid.Column="3"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                Padding="6"
                                                Click="OnRemoveFileItemClicked">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Action Bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                Height="40"
                                Padding="20,0"
                                IsEnabled="{x:Bind ViewModel.CanRunBenchmark, Mode=OneWay}"
                                Command="{x:Bind ViewModel.RunBenchmarkCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Run Multi-Library Benchmark" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Real-Time Progress Card (Visible during execution) -->
            <Border Grid.Row="4"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="10"
                    Padding="24"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressStage, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>

                    <ProgressBar Grid.Row="1"
                                 Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                                 Maximum="100"
                                 Height="8"
                                 CornerRadius="4" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                        <Button Content="Cancel Benchmark"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Command="{x:Bind ViewModel.CancelBenchmarkCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. Benchmark Results &amp; Comparison Section -->
            <StackPanel Grid.Row="5" Spacing="20" Visibility="{x:Bind ViewModel.HasActiveResult, Mode=OneWay}">

                <!-- Results Header &amp; Action Bar -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Benchmark Results &amp; Comparison Matrix" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="Multi-engine scorecard and side-by-side metric comparison"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13" />
                    </StackPanel>

                    <!-- Document View Selector (if multiple docs) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasMultipleDocuments, Mode=OneWay}">
                        <TextBlock Text="Document:" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.DocumentSelections, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDocumentView, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="220" />
                    </StackPanel>

                    <!-- Export & Diff Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                Click="OnInspectDiffClicked"
                                ToolTipService.ToolTip="Inspect side-by-side text diff between parsers">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D2;" FontSize="12" />
                                <TextBlock Text="Inspect Text Diff" />
                            </StackPanel>
                        </Button>
                        <Button Content="Export CSV"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Click="OnExportCsvClicked" />
                        <Button Content="Export JSON"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Click="OnExportJsonClicked" />
                    </StackPanel>
                </Grid>

                <!-- Winner Trophy Scorecard Banner -->
                <Border BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        CornerRadius="10"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Width="52"
                                Height="52"
                                CornerRadius="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE735;" FontSize="26" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.WinnerBannerTitle, Mode=OneWay}"
                                       FontWeight="Bold"
                                       FontSize="16" />
                            <TextBlock Text="{x:Bind ViewModel.WinnerBannerSubtitle, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Competing Engine Scorecards -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.EngineScorecards, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BenchmarkScorecardItemViewModel">
                            <Border BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="10"
                                    Padding="18,16"
                                    Width="260">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Card Header: Engine Name &amp; Rank Badge -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind EngineDisplayName}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{x:Bind RankBadgeText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <!-- Primary Baseline: Extracted Characters -->
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Text="{x:Bind FormattedCharacterCount}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Total Characters (Baseline)"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Metric Summaries Grid -->
                                    <Grid Grid.Row="2" RowSpacing="6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Latency -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1">
                                            <TextBlock Text="Latency" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind FormattedLatency}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <!-- Words -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                            <TextBlock Text="Words" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind FormattedWordCount}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <!-- Memory -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="1">
                                            <TextBlock Text="Memory" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind FormattedMemory}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <!-- Cleanliness -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
                                            <TextBlock Text="Cleanliness" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind CleanlinessScore}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Composite Score Footer -->
                                    <Border Grid.Row="3"
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            Padding="0,8,0,0">
                                        <Grid>
                                            <TextBlock Text="Composite Score"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind FormattedScore}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- Detailed Multi-Metric Comparison Matrix -->
                <Border BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Detailed Comparison Matrix"
                                       FontSize="15"
                                       FontWeight="Bold" />
                            <TextBlock Text="Side-by-side metric comparison across all evaluated parser engines"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Matrix Header Row -->
                        <Grid Padding="12,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="METRIC EVALUATED"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.MatrixEngineHeaders, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}"
                                                   Width="180"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Matrix Data Rows -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MatrixRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BenchmarkMatrixRowViewModel">
                                    <Border BorderThickness="0,0,0,1"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            Padding="12,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Metric Title &amp; Description -->
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind MetricName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Engine Metric Value Cells -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:BenchmarkMatrixCellViewModel">
                                                        <StackPanel Width="180" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind FormattedValue}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium"
                                                                       VerticalAlignment="Center" />
                                                            <Border Visibility="{x:Bind IsBest}"
                                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                                    BorderThickness="1"
                                                                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                                                    CornerRadius="3"
                                                                    Padding="4,1">
                                                                <TextBlock Text="Best"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 7. Historical Sessions Expander -->
            <Expander Grid.Row="6"
                      Header="Recent Benchmark Sessions"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="False">
                <ListView ItemsSource="{x:Bind ViewModel.RecentSessions, Mode=OneWay}"
                          SelectionMode="None"
                          Padding="0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:BenchmarkSessionEntity">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="Medium" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Category}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedDate}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Grid.Column="4"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Padding="6"
                                        Click="OnViewSessionClicked"
                                        ToolTipService.ToolTip="View Benchmark Results Matrix">
                                    <FontIcon Glyph="&#xE890;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Button>
                                <Button Grid.Column="5"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Padding="6"
                                        Click="OnDeleteSessionClicked"
                                        ToolTipService.ToolTip="Delete Session">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>

