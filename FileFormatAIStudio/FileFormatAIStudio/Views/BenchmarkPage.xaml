<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileFormatAIStudio.Views.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:bench="using:FileFormatAIStudio.Services.Benchmarking"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="36,28,36,36" RowSpacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Mode Toggle -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Extraction Benchmark &amp; Comparison"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="Benchmark and rank document text extraction completeness, speed, memory, and cleanliness across all supported parsing libraries."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Button when in Dashboard Mode -->
                    <Button Style="{ThemeResource AccentButtonStyle}"
                            Height="38"
                            Padding="16,0"
                            Visibility="{x:Bind ViewModel.IsDashboardMode, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ShowCreateBenchmarkViewCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="Run New Benchmark" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Button when in Create Benchmark Mode -->
                    <Button Style="{ThemeResource DefaultButtonStyle}"
                            Height="38"
                            Padding="16,0"
                            Visibility="{x:Bind ViewModel.IsCreateBenchmarkMode, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CloseCreateBenchmarkViewCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" />
                            <TextBlock Text="Back to Dashboard" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Status InfoBar -->
            <InfoBar Grid.Row="1"
                     IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <!-- 3. DASHBOARD VIEW (Visible when in Dashboard Mode) -->
            <StackPanel Grid.Row="2" Spacing="24" Visibility="{x:Bind ViewModel.IsDashboardMode, Mode=OneWay}">

                <!-- 3a. Overall Champion Executive Card -->
                <Border BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        CornerRadius="12"
                        Padding="24,20"
                        Visibility="{x:Bind ViewModel.HasOverallChampion, Mode=OneWay}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Trophy Icon -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Width="60"
                                Height="60"
                                CornerRadius="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE735;" FontSize="30" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Champion Title & Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.OverallChampion.HighlightBadge, Mode=OneWay}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Overall High Scorer Across All Benchmarks"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.OverallChampion.ChampionEngineName, Mode=OneWay}"
                                       FontWeight="Bold"
                                       FontSize="22" />

                            <TextBlock Text="Leading parsing performance across evaluated documents with maximum composite score and extraction fidelity."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Stat Highlights Grid -->
                        <Grid Grid.Column="2" ColumnSpacing="20" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="AVG SCORE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.OverallChampion.FormattedAvgScore, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="WIN RATE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.OverallChampion.WinRatePercentage, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="DOCS TESTED" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.OverallChampion.TotalDocumentsEvaluated, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3b. Empty History Welcome Card (when no benchmarks have run yet) -->
                <Border BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="36,32"
                        Visibility="{x:Bind ViewModel.HasNoBenchmarkHistory, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE9D9;" FontSize="44" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No Benchmark Runs Recorded Yet"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Run your first multi-library benchmark across Word, Excel, PowerPoint, PDF, or PlainText documents to view performance champions, metrics, and comparisons."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   MaxWidth="600"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Command="{x:Bind ViewModel.ShowCreateBenchmarkViewCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Run Your First Benchmark" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 3c. Category Champions & Recent Results -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Category Champions &amp; Benchmark Status"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="Select any category to view its latest multi-library comparison matrix and parser scorecard below."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13" />
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind ViewModel.CategoryWinners, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCategoryWinner, Mode=TwoWay}"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              Margin="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,12,4" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BenchmarkCategoryWinnerSummary">
                                <Border BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="10"
                                        Padding="16"
                                        Width="200"
                                        MinHeight="170">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon & Category Name -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Visibility="{x:Bind HasBenchmark}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="5,1">
                                                <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Formats -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{x:Bind FormatsSummary}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- High Scorer Info -->
                                        <StackPanel Grid.Row="2" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="HIGH SCORER"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind WinningEngineName}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind WinningScore}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="{x:Bind HasBenchmark}" />
                                            <TextBlock Text="{x:Bind WinningLatency}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{x:Bind HasBenchmark}" />
                                        </StackPanel>

                                        <!-- Footer -->
                                        <Border Grid.Row="3"
                                                BorderThickness="0,1,0,0"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Padding="0,6,0,0">
                                            <TextBlock Text="{x:Bind FormattedDate}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- 3d. Benchmark Results &amp; Comparison Section (Active Result) -->
                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.HasActiveResult, Mode=OneWay}">

                    <!-- Results Header &amp; Action Bar -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Benchmark Results &amp; Comparison Matrix" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="Multi-engine scorecard and side-by-side metric comparison"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="13" />
                        </StackPanel>

                        <!-- Document View Selector (if multiple docs) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.HasMultipleDocuments, Mode=OneWay}">
                            <TextBlock Text="Document:" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.DocumentSelections, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedDocumentView, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="220" />
                        </StackPanel>

                        <!-- Export & Diff Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnInspectDiffClicked"
                                    ToolTipService.ToolTip="Inspect side-by-side text diff between parsers">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="12" />
                                    <TextBlock Text="Inspect Text Diff" />
                                </StackPanel>
                            </Button>
                            <Button Content="Export CSV"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Click="OnExportCsvClicked" />
                            <Button Content="Export JSON"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Click="OnExportJsonClicked" />
                        </StackPanel>
                    </Grid>

                    <!-- Winner Trophy Scorecard Banner -->
                    <Border BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                            CornerRadius="10"
                            Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Width="52"
                                    Height="52"
                                    CornerRadius="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE735;" FontSize="26" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{x:Bind ViewModel.WinnerBannerTitle, Mode=OneWay}"
                                           FontWeight="Bold"
                                           FontSize="16" />
                                <TextBlock Text="{x:Bind ViewModel.WinnerBannerSubtitle, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Competing Engine Scorecards -->
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EngineScorecards, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BenchmarkScorecardItemViewModel">
                                    <Border BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="10"
                                            Padding="18,16"
                                            Width="260">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Card Header: Engine Name &amp; Rank Badge -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind EngineDisplayName}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{x:Bind RankBadgeText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Score Big Display -->
                                            <StackPanel Grid.Row="1" Spacing="2">
                                                <TextBlock Text="COMPOSITE SCORE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind FormattedScore}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>

                                            <!-- Key Metrics Summary Grid -->
                                            <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="Extracted Text" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedCharacterCount}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="Latency" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedLatency}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="Memory Peak" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedMemory}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="Cleanliness" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind CleanlinessScore}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Error message if any -->
                                            <TextBlock Grid.Row="3"
                                                       Text="{x:Bind ErrorMessage}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind ErrorMessage, Mode=OneWay, Converter={x:Null}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Multi-Metric Comparison Matrix Table -->
                    <Border BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="10"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Side-by-Side Metric Matrix" FontSize="15" FontWeight="Bold" />

                            <!-- Table Header -->
                            <Grid Padding="8,10"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                  CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="EVALUATED METRIC" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.MatrixEngineHeaders, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" Width="180" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Table Rows -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.MatrixRows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BenchmarkMatrixRowViewModel">
                                        <Border BorderThickness="0,0,0,1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Padding="8,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind MetricName}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:BenchmarkMatrixCellViewModel">
                                                            <StackPanel Width="180" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind FormattedValue}"
                                                                           FontSize="13"
                                                                           FontWeight="Medium"
                                                                           VerticalAlignment="Center" />
                                                                <Border Visibility="{x:Bind IsBest}"
                                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                                                        CornerRadius="3"
                                                                        Padding="4,1">
                                                                    <TextBlock Text="Best"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3e. Historical Sessions Expander -->
                <Expander Header="Recent Benchmark Sessions"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="False">
                    <ListView ItemsSource="{x:Bind ViewModel.RecentSessions, Mode=OneWay}"
                              SelectionMode="None"
                              Padding="0,8">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:BenchmarkSessionEntity">
                                <Grid Padding="12,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="Medium" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Category}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedDate}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Grid.Column="4"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="6"
                                            Click="OnViewSessionClicked"
                                            ToolTipService.ToolTip="View Benchmark Results Matrix">
                                        <FontIcon Glyph="&#xE890;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Button>
                                    <Button Grid.Column="5"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="6"
                                            Click="OnDeleteSessionClicked"
                                            ToolTipService.ToolTip="Delete Session">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
            </StackPanel>

            <!-- 4. CREATE BENCHMARK RUNNER VIEW (Visible when in Create Benchmark Mode) -->
            <StackPanel Grid.Row="3" Spacing="20" Visibility="{x:Bind ViewModel.IsCreateBenchmarkMode, Mode=OneWay}">

                <!-- 4a. Category Selection & Format Filter -->
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Fluent Segmented / Pill Strip -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4"
                            HorizontalAlignment="Left">
                        <ListView ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  Margin="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="14,8" />
                                    <Setter Property="Margin" Value="2,0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="36" />
                                    <Setter Property="CornerRadius" Value="7" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BenchmarkCategoryItem">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind FormatsSummary}">
                                        <FontIcon Glyph="{x:Bind IconGlyph}"
                                                  FontSize="15"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Supported Formats Info -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Supported Formats:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="bench:DocumentFormatDescriptor">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{x:Bind Extension}" FontSize="11" FontWeight="Medium" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- 4b. Document Upload & Drag-and-Drop Card -->
                <Border BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="24">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drop Zone -->
                        <Border Grid.Row="0"
                                x:Name="DropZoneBorder"
                                AllowDrop="True"
                                DragOver="OnDragOver"
                                Drop="OnDrop"
                                BorderThickness="2"
                                BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                CornerRadius="8"
                                Padding="28,24"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <FontIcon Glyph="&#xE898;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Drag &amp; drop document files here to benchmark"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Compatible with .docx, .doc, .xlsx, .xls, .pptx, .ppt, .pdf, .txt, .csv"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center" />
                                <Button Content="Browse Documents..."
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0"
                                        Click="OnBrowseFilesClicked" />
                            </StackPanel>
                        </Border>

                        <!-- Selected Files List -->
                        <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.HasSelectedFiles, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="SELECTED DOCUMENTS TO BENCHMARK"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="Clear All"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        FontSize="12"
                                        Margin="12,0,0,0"
                                        Click="OnClearFilesClicked" />
                            </StackPanel>

                            <ListView ItemsSource="{x:Bind ViewModel.SelectedFiles, Mode=OneWay}"
                                      SelectionMode="None"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      CornerRadius="6">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BenchmarkFileItemViewModel">
                                        <Grid Padding="12,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontWeight="Medium" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedFileSize}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <Button Grid.Column="3"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="6"
                                                    Click="OnRemoveFileItemClicked">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Action Bar -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Height="40"
                                    Padding="20,0"
                                    IsEnabled="{x:Bind ViewModel.CanRunBenchmark, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RunBenchmarkCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Run Multi-Library Benchmark" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4c. Real-Time Progress Card (Visible during execution) -->
                <Border BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="24"
                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressRing IsActive="True" Width="20" Height="20" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressStage, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>

                        <ProgressBar Grid.Row="1"
                                     Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                                     Maximum="100"
                                     Height="8"
                                     CornerRadius="4" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                            <Button Content="Cancel Benchmark"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Command="{x:Bind ViewModel.CancelBenchmarkCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
