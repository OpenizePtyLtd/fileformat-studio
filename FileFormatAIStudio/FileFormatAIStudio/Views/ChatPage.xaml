<Page
    x:Class="FileFormatAIStudio.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Status -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.CurrentSession.Title, Mode=OneWay, FallbackValue='Chat'}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Model Selector Dropdown -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Model:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          MinWidth="220" />
            </StackPanel>
        </Grid>

        <!-- Message History List -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                            <Grid Margin="0,6,0,6">
                                <!-- User Bubble (Right Aligned) -->
                                <StackPanel Visibility="{x:Bind UserVisibility, Mode=OneWay}"
                                            HorizontalAlignment="Right"
                                            MaxWidth="650"
                                            Spacing="4">
                                    <TextBlock Text="You"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="12,12,2,12"
                                            Padding="14,10">
                                        <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind TimeString, Mode=OneWay}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <!-- Assistant Bubble (Left Aligned) -->
                                <StackPanel Visibility="{x:Bind AssistantVisibility, Mode=OneWay}"
                                            HorizontalAlignment="Left"
                                            MaxWidth="750"
                                            Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE99A;" FontSize="13" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                        <TextBlock Text="AI Assistant"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12,12,12,2"
                                            Padding="14,12">
                                        <TextBox Text="{x:Bind Content, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 TextWrapping="Wrap"
                                                 Padding="0" />
                                    </Border>
                                    <TextBlock Text="{x:Bind TimeString, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bottom Prompt Input Area -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptTextBox"
                     Grid.Column="0"
                     PlaceholderText="Type your prompt here (Enter to send, Shift+Enter for new line)..."
                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="120"
                     PreviewKeyDown="OnPromptPreviewKeyDown" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <Button Style="{ThemeResource AccentButtonStyle}"
                        Height="38"
                        Width="44"
                        ToolTipService.ToolTip="Send Message"
                        Command="{x:Bind ViewModel.SendMessageCommand}">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

