<Page
    x:Class="FileFormatAIStudio.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Status -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.CurrentSession.Title, Mode=OneWay, FallbackValue='Chat'}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Model Selector Dropdown -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Model:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          MinWidth="220" />
            </StackPanel>
        </Grid>

        <!-- Knowledgebase Attachments Bar -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Attach Knowledgebase Button with Flyout -->
            <Button x:Name="AttachKbButton"
                    Grid.Column="0"
                    Padding="10,6"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Attach Knowledgebase to ground this chat">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                    <TextBlock Text="Attach Knowledgebase" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="AttachKbFlyout" Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="320" Spacing="10">
                            <TextBlock Text="Attach Knowledgebase" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Select a knowledgebase to ground your conversation with its indexed documents."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- No available KBs notice -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Visibility="{x:Bind local:ChatPage.ToInvertedVisibility(ViewModel.HasAvailableKnowledgebases), Mode=OneWay}">
                                <TextBlock Text="No additional knowledgebases available to attach. Create or index new knowledgebases in the Knowledgebase tab."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <!-- Available KBs ListView -->
                            <ListView ItemsSource="{x:Bind ViewModel.AvailableKnowledgebasesToAttach, Mode=OneWay}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="OnAvailableKbItemClick"
                                      MaxHeight="260"
                                      Visibility="{x:Bind local:ChatPage.ToVisibility(ViewModel.HasAvailableKnowledgebases), Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:KnowledgebaseEntity">
                                        <Grid Padding="6,6" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE82D;" FontSize="16" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind EmbeddingModel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Attached KB Chips Bar / Empty Label -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Placeholder when no KBs attached -->
                    <TextBlock Text="No knowledgebases attached (general chat)"
                               FontStyle="Italic"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind local:ChatPage.ToInvertedVisibility(ViewModel.HasAttachedKnowledgebases), Mode=OneWay}" />

                    <!-- Chips List -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AttachedKnowledgebases, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:KnowledgebaseEntity">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="10,4,4,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE82D;" FontSize="11" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Style="{ThemeResource SubtleButtonStyle}"
                                                Padding="4"
                                                Height="22"
                                                Width="22"
                                                CornerRadius="11"
                                                Click="OnDetachKbClick"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Detach knowledgebase">
                                            <FontIcon Glyph="&#xE711;" FontSize="9" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Message History List -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <ScrollViewer x:Name="MessagesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                              HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                            <Grid Margin="0,6,0,6" HorizontalAlignment="Stretch">
                                <!-- User Bubble (Right Aligned) -->
                                <StackPanel Visibility="{x:Bind UserVisibility, Mode=OneWay}"
                                            HorizontalAlignment="Right"
                                            MaxWidth="800"
                                            Spacing="4">
                                    <TextBlock Text="You"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="12,12,2,12"
                                            Padding="14,10">
                                        <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind TimeString, Mode=OneWay}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <!-- Assistant Bubble (100% Width) -->
                                <StackPanel Visibility="{x:Bind AssistantVisibility, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE99A;" FontSize="13" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                        <TextBlock Text="AI Assistant"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12,12,12,2"
                                            Padding="14,12"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                    </Border>

                                    <!-- Source Citations Section -->
                                    <StackPanel Visibility="{x:Bind CitationsVisibility, Mode=OneWay}"
                                                Spacing="6"
                                                Margin="0,4,0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE81C;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind CitationsHeader, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      HorizontalScrollMode="Enabled"
                                                      VerticalScrollMode="Disabled">
                                            <ItemsControl ItemsSource="{x:Bind Citations, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:CitationReference">
                                                        <Button Padding="8,4"
                                                                CornerRadius="8"
                                                                Style="{ThemeResource SubtleButtonStyle}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                ToolTipService.ToolTip="View source reference snippet">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="4,1">
                                                                    <TextBlock Text="{x:Bind DisplayIndex}"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                                </Border>
                                                                <TextBlock Text="{x:Bind DocumentName}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           MaxWidth="160"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind PageOrSectionDisplay}"
                                                                           FontSize="10"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>

                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                                    <StackPanel Width="380" Spacing="8">
                                                                        <Grid ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                                <TextBlock Text="{x:Bind DocumentName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{x:Bind SourceHeaderInfo}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                            </StackPanel>
                                                                            <Border Grid.Column="1"
                                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                                    CornerRadius="4"
                                                                                    Padding="6,2"
                                                                                    VerticalAlignment="Top">
                                                                                <TextBlock Text="{x:Bind MatchScoreText}" FontSize="10" FontWeight="SemiBold" />
                                                                            </Border>
                                                                        </Grid>

                                                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6"
                                                                                    Padding="10">
                                                                                <TextBlock Text="{x:Bind Snippet}"
                                                                                           FontSize="12"
                                                                                           TextWrapping="Wrap"
                                                                                           IsTextSelectionEnabled="True"
                                                                                           LineHeight="18" />
                                                                            </Border>
                                                                        </ScrollViewer>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind TimeString, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bottom Prompt Input Area -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptTextBox"
                     Grid.Column="0"
                     PlaceholderText="Type your prompt here (Enter to send, Shift+Enter for new line)..."
                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="120"
                     PreviewKeyDown="OnPromptPreviewKeyDown" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <Button Style="{ThemeResource AccentButtonStyle}"
                        Height="38"
                        Width="44"
                        ToolTipService.ToolTip="Send Message"
                        Command="{x:Bind ViewModel.SendMessageCommand}">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

