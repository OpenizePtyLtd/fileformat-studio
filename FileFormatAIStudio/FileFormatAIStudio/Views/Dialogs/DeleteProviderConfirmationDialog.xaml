<ContentDialog
    x:Class="FileFormatAIStudio.Views.Dialogs.DeleteProviderConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Delete Provider?"
    PrimaryButtonText="Delete Provider"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    PrimaryButtonStyle="{StaticResource DestructiveButtonStyle}">

    <StackPanel Spacing="16" MaxWidth="480">
        <!-- Warning Banner -->
        <InfoBar Severity="Warning"
                 IsOpen="True"
                 IsClosable="False"
                 Title="Irreversible Action"
                 Message="This action is permanent and cannot be undone." />

        <TextBlock Text="Are you sure you want to delete this provider? The following configuration, credentials, and associated models will be permanently removed:"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Provider Details Card -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="12">
                <!-- Provider Name -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Provider Name:"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Name="ProviderNameTextBlock"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Endpoint URL -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Endpoint URL:"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Name="EndpointUrlTextBlock"
                               TextWrapping="Wrap" />
                </Grid>

                <!-- Saved API Key -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Saved API Key:"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Name="ApiKeyStatusTextBlock" />
                </Grid>

                <!-- Associated Models -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Associated Models:"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="ModelsCountTextBlock" FontWeight="Medium" />
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ModelsListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Margin="0,2,0,2" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>

