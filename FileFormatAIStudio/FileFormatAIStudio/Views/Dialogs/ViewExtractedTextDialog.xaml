<ContentDialog
    x:Class="FileFormatAIStudio.Views.Dialogs.ViewExtractedTextDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:local="using:FileFormatAIStudio.Views.Dialogs"
    mc:Ignorable="d"
    Title="Extracted Document Text"
    PrimaryButtonText="Copy to Clipboard"
    CloseButtonText="Close"
    DefaultButton="Close"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MinWidth="680" MaxWidth="820" MinHeight="500" MaxHeight="680" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Document Meta Header -->
            <RowDefinition Height="Auto" />
            <!-- Statistics Metrics Bar -->
            <RowDefinition Height="Auto" />
            <!-- View Selector (Segmented Tabs) -->
            <RowDefinition Height="Auto" />
            <!-- Content Area (Plain Text / Chunks) -->
            <RowDefinition Height="*" />
            <!-- Status & Feedback InfoBar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Document Header Card -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Document Icon -->
                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        CornerRadius="8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Document Title & Details -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.DocumentName, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.FormattedFileSize, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FileType, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Parser Engine Badge & Status Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE943;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ParserEngineUsed, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3">
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Metrics Bar -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Metric 1: Characters -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <StackPanel Spacing="1">
                    <TextBlock Text="CHARACTERS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CharacterCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Metric 2: Words -->
            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <StackPanel Spacing="1">
                    <TextBlock Text="WORDS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.WordCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Metric 3: Lines -->
            <Border Grid.Column="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <StackPanel Spacing="1">
                    <TextBlock Text="LINES" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.LineCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Metric 4: Chunks -->
            <Border Grid.Column="3"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <StackPanel Spacing="1">
                    <TextBlock Text="CHUNKS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ChunkCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: View Selector (Segmented Tab Bar) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button x:Name="FullTextTabButton"
                        Padding="12,5"
                        CornerRadius="4"
                        Click="OnFullTextTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                        <TextBlock Text="Full Plain Text" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button x:Name="ChunksTabButton"
                        Padding="12,5"
                        CornerRadius="4"
                        Click="OnChunksTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE943;" FontSize="12" />
                        <TextBlock Text="Chunks Breakdown" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="Stored in SQLite (fileformat_studio.db)"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Row 3: Content Body -->
        <Grid Grid.Row="3">
            <!-- Loading Indicator -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="40"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Error State -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="False"
                     VerticalAlignment="Center" />

            <!-- Tab 1: Full Plain Text View -->
            <Border x:Name="FullTextContainer"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <Grid>
                    <!-- Empty Text Notice -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="6"
                                Padding="20"
                                Visibility="{x:Bind local:ViewExtractedTextDialog.InvertBoolToVisibility(ViewModel.HasExtractedText), Mode=OneWay}">
                        <FontIcon Glyph="&#xE8E5;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No text was extracted from this document."
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="The document may be an image-only scan or contains no extractable text stream."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Scrollable Plain Text Box -->
                    <TextBox Text="{x:Bind ViewModel.ExtractedText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas, 'Cascadia Code', 'Segoe UI Mono', monospace"
                             FontSize="12"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <!-- Tab 2: Chunks Breakdown View -->
            <Border x:Name="ChunksContainer"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <Grid>
                    <!-- Empty Chunks Notice -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="6"
                                Padding="20"
                                Visibility="{x:Bind local:ViewExtractedTextDialog.InvertBoolToVisibility(ViewModel.HasChunks), Mode=OneWay}">
                        <FontIcon Glyph="&#xE8E5;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No chunks found for this document."
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Scrollable Chunks List -->
                    <ListView ItemsSource="{x:Bind ViewModel.Chunks, Mode=OneWay}"
                              SelectionMode="None"
                              Padding="6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:DocumentChunkEntity">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <!-- Chunk Header Bar -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                <TextBlock Text="{x:Bind local:ViewExtractedTextDialog.FormatChunkTitle(ChunkIndex)}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind local:ViewExtractedTextDialog.FormatTokens(TokenCount)}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Chunk Content -->
                                        <TextBox Text="{x:Bind TextContent}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas, 'Cascadia Code', 'Segoe UI Mono', monospace"
                                                 FontSize="11"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 4: Copy Feedback InfoBar -->
        <InfoBar Grid.Row="4"
                 IsOpen="{x:Bind ViewModel.IsCopyFeedbackOpen, Mode=TwoWay}"
                 Severity="Informational"
                 Message="{x:Bind ViewModel.CopyFeedbackMessage, Mode=OneWay}"
                 IsClosable="True" />
    </Grid>
</ContentDialog>
