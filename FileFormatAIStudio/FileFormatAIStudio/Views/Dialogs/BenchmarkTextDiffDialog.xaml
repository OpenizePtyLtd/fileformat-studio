<ContentDialog
    x:Class="FileFormatAIStudio.Views.Dialogs.BenchmarkTextDiffDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:bench="using:FileFormatAIStudio.Services.Benchmarking"
    xmlns:local="using:FileFormatAIStudio.Views.Dialogs"
    mc:Ignorable="d"
    Title="Extracted Text Diff &amp; Comparison Inspector"
    PrimaryButtonText="Copy Diff"
    SecondaryButtonText="Copy Left Text"
    CloseButtonText="Close"
    DefaultButton="Close"
    MaxWidth="1080"
    PrimaryButtonClick="OnCopyDiffClicked"
    SecondaryButtonClick="OnCopyLeftClicked">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">840</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="800" MaxWidth="1040" MinHeight="560" MaxHeight="760" RowSpacing="12" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Document Header Card -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        CornerRadius="8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.DocumentName, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.FormattedFileSize, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Multi-Library Extracted Text Comparison"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Copy Right Text"
                            Style="{ThemeResource SubtleButtonStyle}"
                            FontSize="12"
                            Click="OnCopyRightClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Diff Summary Banner -->
        <Border Grid.Row="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.DiffSummaryText, Mode=OneWay}"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Row 2: View Mode Switcher &amp; Toolbar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Mode Switcher Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Button x:Name="SideBySideTabButton"
                        Padding="12,5"
                        CornerRadius="4"
                        Click="OnSideBySideTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7C4;" FontSize="12" />
                        <TextBlock Text="Side-by-Side Panes" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button x:Name="UnifiedDiffTabButton"
                        Padding="12,5"
                        CornerRadius="4"
                        Click="OnUnifiedDiffTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D2;" FontSize="12" />
                        <TextBlock Text="Unified Diff List" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Toolbar Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Filter / search text..."
                         Width="180"
                         FontSize="12" />

                <ToggleButton IsChecked="{x:Bind ViewModel.IsSyncScroll, Mode=TwoWay}"
                              Padding="8,4"
                              CornerRadius="4"
                              ToolTipService.ToolTip="Synchronize vertical scrolling between both panes">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8EE;" FontSize="11" />
                        <TextBlock Text="Sync Scroll" FontSize="11" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind ViewModel.IsWordWrap, Mode=TwoWay}"
                              Padding="8,4"
                              CornerRadius="4"
                              ToolTipService.ToolTip="Toggle Word Wrap">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE765;" FontSize="11" />
                        <TextBlock Text="Word Wrap" FontSize="11" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Row 3: Content Body -->
        <Grid Grid.Row="3">

            <!-- Tab 1: Side-by-Side Dual Panes -->
            <Grid x:Name="SideBySideContainer" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Engine A -->
                <Border Grid.Column="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane A Header -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{x:Bind ViewModel.AvailableEngines, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedEngineA, Mode=TwoWay}"
                                      DisplayMemberPath="EngineDisplayName"
                                      MinWidth="160"
                                      FontSize="12" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.HeaderStatsA, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Pane A Content -->
                        <ScrollViewer Grid.Row="1"
                                      x:Name="LeftScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Enabled"
                                      ViewChanged="OnLeftScrollViewerViewChanged">
                            <TextBox Text="{x:Bind ViewModel.TextA, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="{x:Bind ViewModel.TextWrappingMode, Mode=OneWay}"
                                     FontFamily="Consolas, 'Cascadia Code', 'Segoe UI Mono', monospace"
                                     FontSize="11"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="6" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right Pane: Engine B -->
                <Border Grid.Column="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane B Header -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{x:Bind ViewModel.AvailableEngines, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedEngineB, Mode=TwoWay}"
                                      DisplayMemberPath="EngineDisplayName"
                                      MinWidth="160"
                                      FontSize="12" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.HeaderStatsB, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Pane B Content -->
                        <ScrollViewer Grid.Row="1"
                                      x:Name="RightScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Enabled"
                                      ViewChanged="OnRightScrollViewerViewChanged">
                            <TextBox Text="{x:Bind ViewModel.TextB, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="{x:Bind ViewModel.TextWrappingMode, Mode=OneWay}"
                                     FontFamily="Consolas, 'Cascadia Code', 'Segoe UI Mono', monospace"
                                     FontSize="11"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="6" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Tab 2: Unified Diff List View -->
            <Border x:Name="UnifiedDiffContainer"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <ListView ItemsSource="{x:Bind ViewModel.DiffItems, Mode=OneWay}"
                          SelectionMode="None"
                          Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="bench:TextDiffItem">
                            <Grid Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind LineNumberDisplay}"
                                           FontFamily="Consolas, 'Cascadia Code', monospace"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Prefix}"
                                           FontFamily="Consolas, 'Cascadia Code', monospace"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Content}"
                                           FontFamily="Consolas, 'Cascadia Code', monospace"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- Row 4: Copy Feedback InfoBar -->
        <InfoBar Grid.Row="4"
                 IsOpen="{x:Bind ViewModel.IsCopyFeedbackOpen, Mode=TwoWay}"
                 Severity="Informational"
                 Message="{x:Bind ViewModel.CopyFeedbackMessage, Mode=OneWay}"
                 IsClosable="True" />
    </Grid>
</ContentDialog>