<Page
    x:Class="FileFormatAIStudio.Views.KnowledgebasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Knowledgebases"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           FontSize="26"
                           FontWeight="Bold" />
                <TextBlock Text="Manage vector-indexed document collections and search repositories for grounded RAG chat."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Style="{ThemeResource AccentButtonStyle}"
                        Height="38"
                        Click="OnNewKnowledgebaseClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New Knowledgebase" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Height="38"
                        Width="38"
                        Padding="0"
                        ToolTipService.ToolTip="Refresh Knowledgebases"
                        Click="OnRefreshClicked">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status & Feedback InfoBar -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsClosable="True"
                 Margin="0,0,0,16" />

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Empty State -->
            <Border Visibility="{x:Bind ViewModel.HasNoKnowledgebases, Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="16"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8F1;"
                                  FontSize="30"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>

                    <TextBlock Text="No Knowledgebases Found"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Create a knowledgebase to index Word documents, PDFs, Excel sheets, and text files into hardware-accelerated SIMD vector storage for AI-powered chat."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="20" />

                    <Button Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Height="38"
                            Margin="0,8,0,0"
                            Click="OnNewKnowledgebaseClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Create First Knowledgebase" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Knowledgebases List -->
            <ScrollViewer Visibility="{x:Bind ViewModel.HasKnowledgebases, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Knowledgebases, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KnowledgebaseItemViewModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Margin="0,0,0,16">
                                <StackPanel Spacing="14">
                                    <!-- Card Header -->
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- KB Icon Badge -->
                                        <Border Grid.Column="0"
                                                Width="44"
                                                Height="44"
                                                CornerRadius="10"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>

                                        <!-- Title & Parser Badge (Clickable to toggle documents) -->
                                        <StackPanel Grid.Column="1"
                                                    Spacing="4"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    Tapped="OnToggleDocumentsClicked">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{ThemeResource SubtitleTextBlockStyle}"
                                                           FontWeight="SemiBold" />

                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,2">
                                                    <TextBlock Text="{x:Bind ParserEngine}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>

                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,2">
                                                    <TextBlock Text="{x:Bind FormattedModelInfo}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{ThemeResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"
                                                       Visibility="{x:Bind DescriptionVisibility}" />
                                        </StackPanel>

                                        <!-- Card Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                            <Button Width="36"
                                                    Height="36"
                                                    Padding="0"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Command="{x:Bind ToggleExpandedCommand}">
                                                <FontIcon Glyph="{x:Bind ExpandIconGlyph, Mode=OneWay}" FontSize="13" />
                                            </Button>

                                            <Button Width="36"
                                                    Height="36"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ToolTipService.ToolTip="Delete Knowledgebase"
                                                    Click="OnDeleteKnowledgebaseClicked">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Metadata Metrics Bar (Clickable to toggle documents) -->
                                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          CornerRadius="6"
                                          Padding="14,8"
                                          Tapped="OnToggleDocumentsClicked">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind DocumentCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="documents" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ChunkCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="chunks" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind FormattedTotalSize, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEC92;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind FormattedDate}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Expanded Documents Section -->
                                    <StackPanel Spacing="10" Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}">
                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4,0,4" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="INDEXED DOCUMENTS"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <ProgressRing IsActive="{x:Bind IsAddingDocuments, Mode=OneWay}"
                                                              Width="16" Height="16" VerticalAlignment="Center" />
                                                <Button FontSize="12"
                                                        Padding="10,4"
                                                        IsEnabled="{x:Bind CanAddDocuments, Mode=OneWay}"
                                                        Click="OnAddDocumentsClicked">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                                        <TextBlock Text="Add Documents" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- In-Flight Indexing Progress Banner -->
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,4,0,4"
                                                Visibility="{x:Bind IndexingProgressVisibility, Mode=OneWay}">
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <ProgressRing IsActive="True" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind IndexingMessage, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Height="26"
                                                            Padding="8,0"
                                                            Command="{x:Bind CancelIndexingCommand}"
                                                            ToolTipService.ToolTip="Cancel in-flight indexing">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            <TextBlock Text="Cancel" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- 4-Stage Stepper Pill Bar -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Step 1: Extract -->
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                        <Border Width="16" Height="16" CornerRadius="8"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind Step1ActiveVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE896;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Width="16" Height="16" CornerRadius="8"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind Step1CompletedVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="1. Extract" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                                    <!-- Step 2: Chunk -->
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                        <Border Width="16" Height="16" CornerRadius="8"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind Step2ActiveVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE943;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Width="16" Height="16" CornerRadius="8"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind Step2CompletedVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="2. Chunk" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                                    <!-- Step 3: Embed -->
                                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                        <Border Width="16" Height="16" CornerRadius="8"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind Step3ActiveVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE945;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Width="16" Height="16" CornerRadius="8"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind Step3CompletedVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="3. Embed" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <FontIcon Grid.Column="5" Glyph="&#xE76C;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                                    <!-- Step 4: Store -->
                                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                        <Border Width="16" Height="16" CornerRadius="8"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind Step4ActiveVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE8B7;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Width="16" Height="16" CornerRadius="8"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind Step4CompletedVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="4. Store" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Progress Bar -->
                                                <ProgressBar Value="{x:Bind IndexingPercentage, Mode=OneWay}"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Height="4"
                                                             CornerRadius="2" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Table Column Headers -->
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,6"
                                                Margin="0,4,0,0">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="95" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="DOCUMENT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="PARSER" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="CHUNKS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Column="4" Text="ACTION" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Document List -->
                                        <ListView ItemsSource="{x:Bind Documents, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  IsItemClickEnabled="False">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="MinHeight" Value="42" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="entities:KnowledgebaseDocumentEntity">
                                                    <Grid Padding="12,8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="95" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="40" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Document Info -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind local:KnowledgebasePage.FormatDocumentMeta(FileType, FileSize)}"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Parser Engine Badge -->
                                                        <Border Grid.Column="1"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8,2"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind local:KnowledgebasePage.FormatParser(ParserEngineUsed)}"
                                                                       FontSize="11"
                                                                       FontWeight="Medium"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>

                                                        <!-- Chunk Count Badge -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE943;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            <TextBlock Text="{x:Bind local:KnowledgebasePage.FormatChunks(ChunkCount)}"
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>

                                                        <!-- Status Pill -->
                                                        <Border Grid.Column="3"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8,2"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Status}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        </Border>

                                                        <!-- Delete Document Button -->
                                                        <Button Grid.Column="4"
                                                                Width="30"
                                                                Height="30"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="Delete Document"
                                                                Click="OnDeleteDocumentClicked">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
