<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileFormatAIStudio.Views.DocumentLibrariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:models="using:FileFormatAIStudio.Models"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24,20,24,32" RowSpacing="20" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Page Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Document Libraries" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Browse integrated document extraction libraries, package download stats, release history, and licensing."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LastUpdatedDisplay, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Click="OnGoToPreferencesClicked"
                            ToolTipService.ToolTip="Configure preferred extraction libraries by file format group">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="12" />
                            <TextBlock Text="Library Preferences" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshLiveStatsCommand}"
                            ToolTipService.ToolTip="Fetch live download statistics, versions, and release dates from NuGet and npm">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsRefreshingStats, Mode=OneWay}"
                                          Width="14" Height="14"
                                          Visibility="{x:Bind local:DocumentLibrariesPage.BoolToVisibility(ViewModel.IsRefreshingStats), Mode=OneWay}" />
                            <FontIcon Glyph="&#xE72C;" FontSize="12"
                                      Visibility="{x:Bind local:DocumentLibrariesPage.InvertedBoolToVisibility(ViewModel.IsRefreshingStats), Mode=OneWay}" />
                            <TextBlock Text="Refresh Package Stats" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Metrics Overview Strip -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Metric 1: Total Libraries -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="INTEGRATED LIBRARIES" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalLibrariesCount, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="Across .NET 10 &amp; Node.js" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Metric 2: Total Downloads -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ECOSYSTEM ADOPTION" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalCombinedDownloadsFormatted, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Total NuGet &amp; npm downloads" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Metric 3: Open Source -->
                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="OPEN SOURCE LIBRARIES" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.OpenSourceLibrariesCount, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="MIT &amp; Apache 2.0 (Free)" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Metric 4: Commercial -->
                <Border Grid.Column="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="COMMERCIAL SUITE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.CommercialLibrariesCount, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="Aspose Enterprise Modules" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Refresh Status InfoBar -->
            <InfoBar Grid.Row="2"
                     IsOpen="{x:Bind ViewModel.IsRefreshStatusOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.RefreshStatusSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.LastRefreshedStatus, Mode=OneWay}"
                     IsClosable="True" />

            <!-- Row 3: Aspose Product Licensing Card -->
            <Border Grid.Row="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header: Title & Action Buttons -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D7;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Aspose Commercial Product Licensing" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Upload a commercial Aspose license (.lic) to activate Aspose.Words, Aspose.Cells, Aspose.Slides, and Aspose.PDF with highest parser priority (100) and remove evaluation limits."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="OnBrowseLicenseClicked"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Browse and upload an Aspose license file (.lic)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="12" />
                                    <TextBlock Text="Browse License File (.lic)..." FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnRemoveLicenseClicked"
                                    IsEnabled="{x:Bind ViewModel.CanRemoveAsposeLicense, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    ToolTipService.ToolTip="Remove installed Aspose license and return to evaluation mode">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="Remove License" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Status & Component Badges Row -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: License Path or Evaluation Notice -->
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ViewModel.AsposeLicenseGlyph, Mode=OneWay}"
                                              FontSize="12"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.AsposeLicenseHeaderStatus, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               FontSize="12" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.AsposeLicenseDetailText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- Right: Product Badges -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.WordsBadgeText, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="Medium" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.CellsBadgeText, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="Medium" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.SlidesBadgeText, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="Medium" />
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.PdfBadgeText, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="Medium" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- InfoBar for License Feedback -->
                    <InfoBar Grid.Row="2"
                             IsOpen="{x:Bind ViewModel.IsAsposeLicenseStatusOpen, Mode=TwoWay}"
                             Severity="{x:Bind ViewModel.AsposeLicenseStatusSeverity, Mode=OneWay}"
                             Message="{x:Bind ViewModel.AsposeLicenseStatusMessage, Mode=OneWay}"
                             IsClosable="True" />
                </Grid>
            </Border>

            <!-- Row 4: Search & Filter Toolbar -->
            <Border Grid.Row="4"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0"
                             Header="Search Libraries"
                             PlaceholderText="Search by name, format (.pdf, .docx), or keyword..."
                             Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="1"
                              Header="Format Group"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="{x:Bind ViewModel.SelectedCategoryFilterIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="All Categories" />
                        <ComboBoxItem Content="Word Documents" />
                        <ComboBoxItem Content="Excel Workbooks" />
                        <ComboBoxItem Content="PowerPoint Slides" />
                        <ComboBoxItem Content="PDF Documents" />
                        <ComboBoxItem Content="Plain Text" />
                    </ComboBox>

                    <!-- License Filter -->
                    <ComboBox Grid.Column="2"
                              Header="License Model"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="{x:Bind ViewModel.SelectedLicenseFilterIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="All Licenses" />
                        <ComboBoxItem Content="Open Source (Free)" />
                        <ComboBoxItem Content="Commercial / Paid" />
                    </ComboBox>

                    <!-- Sort Filter -->
                    <ComboBox Grid.Column="3"
                              Header="Sort By"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Most Downloads" />
                        <ComboBoxItem Content="Recently Published" />
                        <ComboBoxItem Content="Market Longevity" />
                        <ComboBoxItem Content="Library Name (A-Z)" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Row 5: Libraries Cards List -->
            <StackPanel Grid.Row="5" Spacing="12">
                <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredLibraries, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DocumentLibraryInfo">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20,16"
                                    Margin="0,0,0,12">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Name, Ecosystem, License Badge & Links -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Title & Badges -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />

                                            <!-- Ecosystem Badge -->
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Ecosystem}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <!-- License Badge -->
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind LicenseType}" FontSize="11" FontWeight="Medium"
                                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Direct Web Links -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Padding="6,3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnOpenPackageUrlClicked"
                                                    ToolTipService.ToolTip="View package on repository">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind DownloadStatsSource}" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button Padding="6,3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnOpenProjectUrlClicked"
                                                    ToolTipService.ToolTip="View official documentation / repository">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                                    <TextBlock Text="Project Site" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind Description}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <!-- Key Health & Reputation Stats Grid -->
                                    <Border Grid.Row="2"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Stat 1: Total Downloads -->
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="POPULARITY" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind DownloadsFormatted, Mode=OneWay}"
                                                           FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="Total downloads" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Stat 2: Update Recency -->
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="UPDATE RECENCY" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind RecencyText, Mode=OneWay}"
                                                           FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="Actively maintained" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Stat 3: Longevity & Releases -->
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE81C;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="MARKET LONGEVITY" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind MarketLongevityText, Mode=OneWay}"
                                                           FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="Battle-tested stability" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Stat 4: App Licensing / Local Status -->
                                            <StackPanel Grid.Column="3" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="APP STATUS" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind LicenseStatus, Mode=OneWay}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="{x:Bind local:DocumentLibrariesPage.GetInstalledVersionText(InstalledVersion)}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Row: Supported Extensions Summary -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Supported Formats: "
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind SupportedExtensionsSummary}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="32"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind local:DocumentLibrariesPage.BoolToVisibility(ViewModel.HasNoLibraries), Mode=OneWay}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No Libraries Match Filters" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="Try adjusting your search keywords, format group, or license model filters."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

