<Page
    x:Class="FileFormatAIStudio.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    ToolTipService.ToolTip="Back to Chat"
                    Click="OnCloseSettingsClicked"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Click="OnCloseSettingsClicked"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    <TextBlock Text="Close Settings" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 1: Tab Navigation Strip -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Style="{x:Bind local:SettingsPage.GetTabButtonStyle(ViewModel.IsAiProvidersTabActive), Mode=OneWay}"
                        Click="OnAiProvidersTabClicked"
                        Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE753;" FontSize="13" />
                        <TextBlock Text="AI Providers &amp; Models" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Style="{x:Bind local:SettingsPage.GetTabButtonStyle(ViewModel.IsDocumentEnginesTabActive), Mode=OneWay}"
                        Click="OnDocumentEnginesTabClicked"
                        Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                        <TextBlock Text="Document Engines" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Tab 1: AI Providers & Models Body -->
        <Grid Grid.Row="2" ColumnSpacing="24" Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsAiProvidersTabActive), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Providers List -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Providers" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:ProviderConfigEntity">
                                <Grid Padding="6,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind ProviderType}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="2"
                            Content="+ Add Provider"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.CanAddProvider, Mode=OneWay}"
                            ToolTipService.ToolTip="Add a new provider (max 1 unconfigured at a time)"
                            Command="{x:Bind ViewModel.AddProviderCommand}" />

                    <Button Grid.Row="3"
                            Content="Restore Default Providers"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="Restore standard built-in providers (OpenAI, OpenRouter, Local gptoss)"
                            Command="{x:Bind ViewModel.RestoreDefaultProvidersCommand}" />
                </Grid>
            </Border>

            <!-- Right: Provider Detail & Models -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind local:SettingsPage.ToVisibility(ViewModel.SelectedProvider), Mode=OneWay}">
                <StackPanel Spacing="20" Margin="0,0,12,0">

                    <!-- Provider Details Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Provider Configuration" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                                <Button Grid.Column="1"
                                        Content="Delete Provider"
                                        Foreground="Red"
                                        Click="OnDeleteProviderClicked" />
                            </Grid>

                            <TextBox Header="Provider Name"
                                     Text="{x:Bind ViewModel.SelectedProvider.Name, Mode=TwoWay}" />

                            <TextBox Header="Endpoint URL (e.g., https://api.openai.com/v1 or http://localhost:8000/v1)"
                                     Text="{x:Bind ViewModel.SelectedProvider.EndpointUrl, Mode=TwoWay}" />

                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Header="API Key"
                                         PasswordRevealMode="Peek"
                                         PasswordChanged="OnApiKeyPasswordChanged" />

                            <ToggleSwitch Header="Enable this Provider"
                                          IsOn="{x:Bind ViewModel.SelectedProvider.IsEnabled, Mode=TwoWay}" />

                            <InfoBar IsOpen="{x:Bind ViewModel.IsSaveStatusOpen, Mode=TwoWay}"
                                     Severity="{x:Bind ViewModel.SaveStatusSeverity, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.SaveStatusMessage, Mode=OneWay}"
                                     IsClosable="True" />

                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Button Content="Save Provider Settings"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SaveProviderCommand}" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsSavingProvider, Mode=OneWay}"
                                              Width="20" Height="20" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Models Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Supported Models" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                            <ListView ItemsSource="{x:Bind ViewModel.SelectedProviderModels, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:ModelConfigEntity">
                                        <Grid Padding="4,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="Medium" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ModelId}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind local:SettingsPage.FormatModelBadge(IsEmbeddingModel, Dimensions)}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Button Grid.Column="2"
                                                    Content="Remove"
                                                    FontSize="12"
                                                    Click="OnDeleteModelClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Add Model Section -->
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Header="Model ID (e.g. gpt-4o, nomic-embed-text)"
                                             Text="{x:Bind ViewModel.NewModelId, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1"
                                             Header="Display Name"
                                             Text="{x:Bind ViewModel.NewModelDisplayName, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="2"
                                              Header="Model Type"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="{x:Bind ViewModel.NewModelTypeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Chat (LLM)" />
                                        <ComboBoxItem Content="Embedding" />
                                    </ComboBox>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                        <Button Content="Add Model"
                                                Command="{x:Bind ViewModel.AddModelCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanAddModel, Mode=OneWay}" />
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsAddingModel, Mode=OneWay}"
                                                      Width="18" Height="18" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Test Connection Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Test Connection" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="Verify your endpoint URL, API key, and model responsiveness with a quick ping."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Button Content="Test Connection"
                                        Command="{x:Bind ViewModel.TestConnectionCommand}" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay}"
                                              Width="24" Height="24" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.TestStatusMessage, Mode=OneWay}"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right: Empty State when no provider is selected -->
            <Grid Grid.Column="1"
                  Visibility="{x:Bind local:SettingsPage.ToInvertedVisibility(ViewModel.SelectedProvider), Mode=OneWay}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                <StackPanel Spacing="16" MaxWidth="440" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE753;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No Provider Selected"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Select a provider from the left panel, add a custom provider, or restore default built-in providers."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="+ Add Provider"
                                Command="{x:Bind ViewModel.AddProviderCommand}"
                                IsEnabled="{x:Bind ViewModel.CanAddProvider, Mode=OneWay}" />
                        <Button Content="Restore Default Providers"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RestoreDefaultProvidersCommand}" />
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind ViewModel.IsSaveStatusOpen, Mode=TwoWay}"
                             Severity="{x:Bind ViewModel.SaveStatusSeverity, Mode=OneWay}"
                             Message="{x:Bind ViewModel.SaveStatusMessage, Mode=OneWay}"
                             IsClosable="True" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Tab 2: Document Engines Configuration Body -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsDocumentEnginesTabActive), Mode=OneWay}">
            <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left" Margin="0,0,16,24">

                <!-- Header Actions Bar -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="PREFERRED PARSER ENGINES BY DOCUMENT CATEGORY"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Choose which library to use when reading files from each category. 'Auto' dynamically uses the category's overall winner from your benchmark runs."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ResetAllCategoriesToAutoCommand}"
                            ToolTipService.ToolTip="Reset all categories to Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                            <TextBlock Text="Reset All to Auto" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar IsOpen="{x:Bind ViewModel.IsEngineSettingsStatusOpen, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.EngineSettingsStatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.EngineSettingsStatusMessage, Mode=OneWay}"
                         IsClosable="True" />

                <!-- Categories Cards List -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.DocumentCategories, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentCategorySettingItemViewModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20,16"
                                    Margin="0,0,0,12">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon, Title, Formats, and Dropdown -->
                                    <Grid Grid.Row="0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="340" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Category Icon -->
                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                                      FontSize="18"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Category Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind CategoryName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="15" />
                                            <TextBlock Text="{x:Bind SupportedFormatsSummary}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Engine Selector Dropdown -->
                                        <ComboBox Grid.Column="2"
                                                  Header="Preferred Engine"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind AvailableEngines}"
                                                  SelectedItem="{x:Bind SelectedEngine, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                    </Grid>

                                    <!-- Bottom Row: Benchmark Champion Status & Feedback -->
                                    <Border Grid.Row="1"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE735;"
                                                      FontSize="12"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                      VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind BenchmarkStatusText, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind StatusFeedback, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

