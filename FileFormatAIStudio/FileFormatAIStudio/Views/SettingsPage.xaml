<Page
    x:Class="FileFormatAIStudio.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:entities="using:FileFormatAIStudio.Data.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,20,24,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    ToolTipService.ToolTip="Back to Chat"
                    Click="OnCloseSettingsClicked"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="AI Providers &amp; Models Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Configure cloud and local LLM endpoints (OpenAI, OpenRouter, Local company LLMs)"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Click="OnCloseSettingsClicked"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    <TextBlock Text="Close Settings" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Settings Body -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Providers List -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Providers" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:ProviderConfigEntity">
                                <Grid Padding="6,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind ProviderType}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="2"
                            Content="+ Add Provider"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.CanAddProvider, Mode=OneWay}"
                            ToolTipService.ToolTip="Add a new provider (max 1 unconfigured at a time)"
                            Command="{x:Bind ViewModel.AddProviderCommand}" />

                    <Button Grid.Row="3"
                            Content="Restore Default Providers"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="Restore standard built-in providers (OpenAI, OpenRouter, Local gptoss)"
                            Command="{x:Bind ViewModel.RestoreDefaultProvidersCommand}" />
                </Grid>
            </Border>

            <!-- Right: Provider Detail & Models -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind local:SettingsPage.ToVisibility(ViewModel.SelectedProvider), Mode=OneWay}">
                <StackPanel Spacing="20" Margin="0,0,12,0">

                    <!-- Provider Details Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Provider Configuration" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                                <Button Grid.Column="1"
                                        Content="Delete Provider"
                                        Foreground="Red"
                                        Click="OnDeleteProviderClicked" />
                            </Grid>

                            <TextBox Header="Provider Name"
                                     Text="{x:Bind ViewModel.SelectedProvider.Name, Mode=TwoWay}" />

                            <TextBox Header="Endpoint URL (e.g., https://api.openai.com/v1 or http://localhost:8000/v1)"
                                     Text="{x:Bind ViewModel.SelectedProvider.EndpointUrl, Mode=TwoWay}" />

                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Header="API Key"
                                         PasswordRevealMode="Peek"
                                         PasswordChanged="OnApiKeyPasswordChanged" />

                            <ToggleSwitch Header="Enable this Provider"
                                          IsOn="{x:Bind ViewModel.SelectedProvider.IsEnabled, Mode=TwoWay}" />

                            <InfoBar IsOpen="{x:Bind ViewModel.IsSaveStatusOpen, Mode=TwoWay}"
                                     Severity="{x:Bind ViewModel.SaveStatusSeverity, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.SaveStatusMessage, Mode=OneWay}"
                                     IsClosable="True" />

                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Button Content="Save Provider Settings"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SaveProviderCommand}" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsSavingProvider, Mode=OneWay}"
                                              Width="20" Height="20" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Models Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Supported Models" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                            <ListView ItemsSource="{x:Bind ViewModel.SelectedProviderModels, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:ModelConfigEntity">
                                        <Grid Padding="4,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="Medium" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ModelId}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind local:SettingsPage.FormatModelBadge(IsEmbeddingModel, Dimensions)}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Button Grid.Column="2"
                                                    Content="Remove"
                                                    FontSize="12"
                                                    Click="OnDeleteModelClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Add Model Section -->
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Header="Model ID (e.g. gpt-4o, nomic-embed-text)"
                                             Text="{x:Bind ViewModel.NewModelId, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1"
                                             Header="Display Name"
                                             Text="{x:Bind ViewModel.NewModelDisplayName, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="2"
                                              Header="Model Type"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="{x:Bind ViewModel.NewModelTypeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Chat (LLM)" />
                                        <ComboBoxItem Content="Embedding" />
                                    </ComboBox>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                        <Button Content="Add Model"
                                                Command="{x:Bind ViewModel.AddModelCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanAddModel, Mode=OneWay}" />
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsAddingModel, Mode=OneWay}"
                                                      Width="18" Height="18" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Test Connection Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Test Connection" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="Verify your endpoint URL, API key, and model responsiveness with a quick ping."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Button Content="Test Connection"
                                        Command="{x:Bind ViewModel.TestConnectionCommand}" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay}"
                                              Width="24" Height="24" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.TestStatusMessage, Mode=OneWay}"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right: Empty State when no provider is selected -->
            <Grid Grid.Column="1"
                  Visibility="{x:Bind local:SettingsPage.ToInvertedVisibility(ViewModel.SelectedProvider), Mode=OneWay}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                <StackPanel Spacing="16" MaxWidth="440" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE753;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No Provider Selected"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Select a provider from the left panel, add a custom provider, or restore default built-in providers."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="+ Add Provider"
                                Command="{x:Bind ViewModel.AddProviderCommand}"
                                IsEnabled="{x:Bind ViewModel.CanAddProvider, Mode=OneWay}" />
                        <Button Content="Restore Default Providers"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RestoreDefaultProvidersCommand}" />
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind ViewModel.IsSaveStatusOpen, Mode=TwoWay}"
                             Severity="{x:Bind ViewModel.SaveStatusSeverity, Mode=OneWay}"
                             Message="{x:Bind ViewModel.SaveStatusMessage, Mode=OneWay}"
                             IsClosable="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>

